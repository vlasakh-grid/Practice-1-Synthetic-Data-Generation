# Local PostgreSQL container
POSTGRES_DB=synthetic_data
POSTGRES_USER=synthetic_user
POSTGRES_PASSWORD=change-me-before-starting
POSTGRES_PORT=5432

# Non-superuser application roles. Change both passwords before first startup.
APP_DB_USER=synthetic_writer
APP_DB_PASSWORD=change-me-before-starting
ANALYTICS_DB_USER=synthetic_reader
ANALYTICS_DB_PASSWORD=change-me-before-starting

# Streamlit application
APP_PORT=8501

# Gemini / Vertex AI (needed when LLM features are implemented)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Docker: mount a service-account JSON at /run/secrets/vertex-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/vertex-service-account.json

# Langfuse (needed when observability is implemented)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
